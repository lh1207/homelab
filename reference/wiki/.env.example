# reference/wiki (BookStack) — copy to `.env` and set strong values.
#   cp .env.example .env  &&  edit .env
# .env is git-ignored; never commit real values.
#
# For a migration, retain the source APP_KEY; do not generate a replacement.
# For a new installation only, APP_KEY must be: base64:<32 random bytes, base64-encoded>. Generate with:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGEME
# BOOKSTACK_DB_PASS is used by BOTH bookstack (DB_PASSWORD) and mariadb (MYSQL_PASSWORD) — keep them identical.
BOOKSTACK_DB_PASS=changeme
MYSQL_ROOT_PASSWORD=changeme

# Preserve the selected persistent volumes when redeploying or restoring.
BOOKSTACK_DATA_VOLUME=wiki_bookstack_migrated_20261018
BOOKSTACK_DB_VOLUME=wiki_bookstack_db_migrated_20261018
