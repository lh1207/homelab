# reference/dns (Pi-hole) — copy to `.env` and set a strong password.
#   cp .env.example .env  &&  edit .env
# .env is git-ignored; never commit real values.
PIHOLE_WEBPASSWORD=changeme
# Pi-hole's advertised LAN IP (FTLCONF_dns_reply_host_IPv4), e.g. 192.168.1.20
PIHOLE_HOST_IP=<pihole-host-ip>

# Existing migrated deployment volumes; change only for a deliberate restore.
PIHOLE_DATA_VOLUME=dns_pihole_migrated_20261018
PIHOLE_DNSMASQ_VOLUME=dns_pihole_dnsmasq_migrated_20261018
# The live migration preserves the password hash in pihole.toml and omits the
# password environment override. Keep that behavior when reusing migrated data.
