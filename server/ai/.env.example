# server/ai (Open WebUI) — copy to `.env` and set values.
#   cp .env.example .env  &&  edit .env
# .env is git-ignored; never commit real addresses.
#
# Open WebUI talks to Ollama running baremetal on the Mac, so point this at the
# Mac's LAN IP, e.g. http://192.168.1.60:11434.
#
# If Ollama runs on the same Linux Docker host as this stack, the compose file
# also maps host.docker.internal to Docker's host gateway, so use:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://<mac-ip>:11434
