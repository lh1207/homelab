# workstation/networking (Caddy) — copy to `.env` and set values.
#   cp .env.example .env  &&  edit .env
# .env is git-ignored; never commit real addresses.
#
# The Caddyfile reverse-proxies *.localhost to the Docker LXC via {$DOCKER_LXC_IP}.
# Set this to that host's LAN IP, e.g. 192.168.1.30
DOCKER_LXC_IP=<docker-lxc-ip>
# Full upstream URLs; services may run on the Docker LXC, Mac, or separate LXCs.
PGADMIN_UPSTREAM=http://<pgadmin-host-ip>:5050
OLLAMA_UPSTREAM=http://<ollama-host-ip>:11434
BOOKSTACK_UPSTREAM=http://<bookstack-lxc-ip>:<web-port>
PIHOLE_UPSTREAM=http://<pihole-lxc-ip>:<web-port>
