{
  admin off
  local_certs
}

# ── Configurable upstreams ───────────────────────────────────────────────────────────────

ollama.localhost {
  reverse_proxy {$OLLAMA_UPSTREAM}
}

pgadmin.localhost {
  reverse_proxy {$PGADMIN_UPSTREAM}
}

# ── Docker LXC ({$DOCKER_LXC_IP}, set in .env) ───────────────────────────────

# AI
homepage.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:3004
}

ai.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:3000
}

staging.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:8090
}

# Services
vault.localhost {
  encode gzip
  reverse_proxy {$DOCKER_LXC_IP}:8080
}

git.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:3001
}

# BookStack may run on the Docker LXC or a separate LXC.
bookstack.localhost {
  reverse_proxy {$BOOKSTACK_UPSTREAM}
}

# Media
jellyfin.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:8096
}

# Home
homebridge.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:8581
}

# DNS
# Pi-hole may run on the Docker LXC or a separate LXC.
pihole.localhost {
  redir / /admin/ 308
  reverse_proxy {$PIHOLE_UPSTREAM}
}

# Monitoring
grafana.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:3002
}

