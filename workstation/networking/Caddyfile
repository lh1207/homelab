{
  admin off
  auto_https off
}

# ── Local (Mac) ───────────────────────────────────────────────────────────────

ollama.localhost {
  reverse_proxy host.docker.internal:11434
}

pgadmin.localhost {
  reverse_proxy host.docker.internal:5050
}

# ── Docker LXC ({$DOCKER_LXC_IP}, set in .env) ───────────────────────────────

# AI
ai.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:3000
}

# Services
vault.localhost {
  encode gzip
  reverse_proxy {$DOCKER_LXC_IP}:8080
}

git.localhost {
  reverse_proxy {$DOCKER_LXC_IP}:3001
}

# NOTE: BookStack runs in its own Proxmox LXC, not the Docker LXC.
